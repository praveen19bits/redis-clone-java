    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "RedisServer (epoll debug)",
            "request": "launch",
            "mainClass": "com.praveen.redisclone.RedisServer",
            "projectName": "redis-clone-java",
            "args": ["--mode=epoll"]
        },
        {
            "type": "java",
            "name": "RedisServer (thread debug)",
            "request": "launch",
            "mainClass": "com.praveen.redisclone.RedisServer",
            "projectName": "redis-clone-java",
            "args": ["--mode=thread"]
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "RedisServer",
            "request": "launch",
            "mainClass": "com.praveen.redisclone.RedisServer",
            "projectName": "redis-clone-java"
        }
    ]
}